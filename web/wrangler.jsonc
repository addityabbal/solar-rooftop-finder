{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solar-rooftop-finder",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "solar-rooftop-finder" }
  ],
  "routes": [{ "pattern": "solar.adityabal.com", "custom_domain": true }],
  "observability": { "enabled": true },
  // Public, non-secret settings. Secrets (GOOGLE_SERVER_KEY, SUPABASE_SERVICE_ROLE_KEY,
  // CAMPAIGN_ADMIN_PASSWORD, ...) go in with: npx wrangler secret put <NAME>
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://solar.adityabal.com"
  }
}
