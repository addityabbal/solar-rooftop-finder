# Copy to .env (worker, repo root) and to web/.env.local (web app). Never commit real values.

# --- Google Maps Platform ---
# Server key: restrict to Solar API, Geocoding API, Places API (New). Used by worker and web server routes.
GOOGLE_SERVER_KEY=
# Browser key: restrict by HTTP referrer and to Maps JavaScript API only.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- Supabase (leave empty to use local JSON files in web/data/scans) ---
SUPABASE_URL=
# Service role key: worker and web server routes only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstash Redis (rate limits; leave empty to disable limits locally) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- GitHub (web triggers the scan workflow) ---
# Fine-grained token with "Contents: read and write" on the repo (needed for repository_dispatch).
GITHUB_DISPATCH_TOKEN=
# owner/name, e.g. yourname/solar-rooftop-finder
GITHUB_REPO=

# --- Worker options ---
# Path to an India Post pincode boundary GeoJSON, if you have a licensed copy.
PINCODE_BOUNDARY_GEOJSON=
# Local development only: when no boundary file and no Google key exist, look up the
# pincode rectangle from OpenStreetMap Nominatim. Set to 0 to forbid.
ALLOW_NOMINATIM_FALLBACK=1
# Solar API quality floor: BASE covers the most Indian rooftops.
SOLAR_REQUIRED_QUALITY=BASE

# --- Campaign layer (Phase 7) ---
# Public address of the site, used in postcard QR codes. e.g. https://solar.yourdomain.com
NEXT_PUBLIC_SITE_URL=
# Password for /campaigns (any username). Required in production; the dashboard shows bookings.
CAMPAIGN_ADMIN_PASSWORD=
# Installer who makes the site visits. Empty = demonstration cards and microsites.
CAMPAIGN_INSTALLER_NAME=
# Leave unset. "true" only when a real installer backs the campaign. See docs/MAILING.md.
MAILING_ENABLED=
